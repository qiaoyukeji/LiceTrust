# ===== LiceTrust（正版软件管理平台）后端环境变量示例 =====
# 复制为 .env 后按需修改；所有项均有开发默认值

# 服务端口
PORT=3000

# JWT
JWT_SECRET=licetrust-dev-secret-change-in-prod
JWT_EXPIRES=12h

# 敏感信息加密密钥（AES-256，激活码/序列号/管理员密码）
AES_KEY=licetrust-dev-aes-key-change-in-prod

# 数据库：sqlite（开发默认，零依赖）| mysql（生产）
DB_DIALECT=sqlite
SQLITE_PATH=./data/licetrust.db

# MySQL 连接（DB_DIALECT=mysql 时生效，兼容达梦/人大金仓 MySQL 模式时另行适配）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=123456
# DB_NAME=licetrust

# 上传文件目录
UPLOAD_DIR=./data/uploads

# ===== 短信服务（注册手机号验证码 / 预警短信推送）=====
# 终端 Agent 上报 AppKey（生产请替换强随机值）
AGENT_KEY=licetrust-agent-dev-key
# SMS_MODE 三种模式：
#   mock         模拟模式（默认）：不真实发送，验证码在发送接口响应中回显，便于开发与演示
#   alibaba      阿里云短信服务 Dysmsapi.SendSms：自配签名+模板（验证码占位符 ${code}），本地生成并校验
#   alibaba_pnvs 阿里云号码认证服务《码号资源短信认证》Dypnsapi：
#                SendSmsVerifyCode 生成验证码（占位符 ##code##，阿里云生成）
#                CheckSmsVerifyCode 校验（核验结果以 Model.VerifyResult === 'PASS' 为准）
SMS_MODE=mock

# 阿里云 RAM AccessKey（具有短信/号码认证 API 权限）
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=

# 模式 alibaba：短信服务控制台申请的签名与模板（模板需含变量 ${code}）
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# SMS_ENDPOINT=dysmsapi.aliyuncs.com

# 模式 alibaba_pnvs：号码认证服务控制台的"赠送签名"与"赠送模板"（模板占位符用 ##code##）
# SMS_PNVS_SIGN_NAME=
# SMS_PNVS_TEMPLATE_CODE=
# SMS_PNVS_SCHEME_NAME=
# SMS_PNVS_ENDPOINT=dypnsapi.aliyuncs.com
# 联调时设为 true，发送响应会回显验证码（生产必须关闭）
# SMS_PNVS_RETURN_CODE=false
